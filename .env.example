# LOCAL DEVELOPMENT ONLY — do not use these values in production.
# Copy to .env (ignored by Git) and replace both passwords with unique local values.
POSTGRES_DB=trevvos_dev
POSTGRES_USER=trevvos_dev
POSTGRES_PASSWORD=change_me_for_local_dev
POSTGRES_PORT=55432

# Used when starting the API directly on your host, outside Docker.
# Keep this password in sync with POSTGRES_PASSWORD above.
ConnectionStrings__TrevvosDb=Host=localhost;Port=55432;Database=trevvos_dev;Username=trevvos_dev;Password=change_me_for_local_dev

RABBITMQ_DEFAULT_USER=trevvos_dev
RABBITMQ_DEFAULT_PASS=change_me_for_local_dev
